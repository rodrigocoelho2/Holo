# Copy this file to ".env" (next to docker-compose.yml) and fill it in.
# .env holds secrets: don't share it or put it in git.
# No spaces around "=". If a value has # or spaces, wrap it in single quotes: 'a#b c'.

# ---------- Required ----------

# Holo's setup key: asked for only when creating the FIRST account (the admin), so nobody else on the network
# can create it before you. After that you sign in with your own user name and password.
DASHBOARD_PASSWORD=change-this

# Anyone without an account can create one on the "Create account" screen. Set false so only the admin creates
# accounts (in Settings → Account).
# ALLOW_REGISTRATION=true

# Internal key between the dashboard and the bot. Make up a long random string
# (e.g. in PowerShell:  -join ((48..57)+(97..122) | Get-Random -Count 40 | % {[char]$_}) ).
TCG_API_KEY=change-this-to-a-long-random-key

# ---------- WhatsApp (CallMeBot) ----------
# 1. Save the CallMeBot number published at https://www.callmebot.com/blog/free-api-whatsapp-messages/ to your contacts.
# 2. Send it on WhatsApp:  I allow callmebot to send me messages
# 3. The API key comes back in a reply. Put YOUR number (with +351) and that key below.
WhatsApp__Enabled=false
WhatsApp__Phone=+351900000000
WhatsApp__ApiKey=

# ---------- Telegram (optional) ----------
# 1. In Telegram, talk to @BotFather → /newbot → give it a name. You get the bot's token (e.g. 123456:ABC-…).
# 2. Open your new bot and send it /start (without this, Telegram won't let the bot write to you).
# 3. Find your chat id: talk to @userinfobot (it answers with your "Id"). For a group, the id starts with -100…
Telegram__Enabled=false
Telegram__BotToken=
Telegram__ChatId=

# ---------- Push notifications (on by default) ----------
# Each phone/computer turns them on in Settings → Alert channels → "Turn on for this device" (needs HTTPS).
# The keys are created by themselves in the data volume. The Subject is a contact for Apple/Google: put your email.
WebPush__Enabled=true
WebPush__Subject=mailto:you@example.com

# ---------- Email (optional; Gmail example with an "App password") ----------
Email__Enabled=false
Email__SmtpHost=smtp.gmail.com
Email__SmtpPort=587
Email__UseStartTls=true
Email__Username=
Email__Password=
Email__From=
Email__To__0=

# ---------- Amazon.es (official "Creators API") ----------
# Only works with an approved Amazon Associates (affiliate) account with Creators API access
# (Amazon requires 10 qualifying sales in the last 30 days). Credentials are in:
# Associates Central → Tools → Creators API → Create Application / Add New Credential.
# The version shows next to the credential; amazon.es = 3.2 (Europe). Without this, the Amazon store shows
# "integration not configured" and Amazon isn't contacted.
Amazon__CredentialId=
Amazon__CredentialSecret=
Amazon__CredentialVersion=3.2
Amazon__PartnerTag=

# ---------- Limits per domain (optional; appsettings.json already has defaults) ----------
# Value = MINIMUM number of SECONDS between two requests to the same domain (subdomains included).
# OutboundHttp__RateLimits__amazon.es=2
# OutboundHttp__DefaultRateLimitSeconds=2

# ---------- FNAC / Worten / El Corte Inglés (Awin affiliate feeds) ----------
# None of these stores has a public product API. The allowed source is the product feed of their affiliate
# programme at Awin (https://www.awin.com), once the programme approves you:
#   El Corte Inglés ES → programme 13075 · Worten PT → programme 99897 (check it has a feed) · FNAC PT → no confirmed programme.
# In Awin → Toolbox → Create-a-Feed: pick the feed, CSV format, comma delimiter, gzip compression and the columns
# product_name, search_price, currency, in_stock, stock_status, merchant_deep_link, aw_deep_link, merchant_product_id, merchant_name.
# Paste the download URL here (it's secret: it holds your feed key). Empty = store not configured.
AwinFeeds__Feeds__ElCorteIngles=
AwinFeeds__Feeds__Worten=
AwinFeeds__Feeds__Fnac=
# Other stores with the "Awin (generic)" platform: the key is the one you set on the store, e.g.:
# AwinFeeds__Feeds__MediaMarktES=
