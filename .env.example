# Copia este ficheiro para ".env" (ao lado do docker-compose.yml) e preenche.
# O .env tem segredos: não o partilhes nem o metas no git.
# Sem espaços à volta do "=". Se um valor tiver # ou espaços, põe-o entre plicas: 'a#b c'.

# ---------- Obrigatório ----------

# Password do dashboard (o browser pede-a; qualquer nome de utilizador serve).
DASHBOARD_PASSWORD=seu_password_aqui

# Chave interna entre o dashboard e o bot. Inventa uma sequência longa e aleatória
# (ex.: no PowerShell:  -join ((48..57)+(97..122) | Get-Random -Count 40 | % {[char]$_}) ).
TCG_API_KEY=sua_api_key_aqui

# ---------- WhatsApp (CallMeBot) ----------
# 1. Guarda nos contactos o número do CallMeBot publicado em https://www.callmebot.com/blog/free-api-whatsapp-messages/
# 2. Envia-lhe pelo WhatsApp:  I allow callmebot to send me messages
# 3. Recebes a API key numa resposta. Põe o TEU número (com +351) e essa key abaixo.
WhatsApp__Enabled=false
WhatsApp__Phone=+351xxxxxxxxxx
WhatsApp__ApiKey=sua_whatsapp_api_key

# ---------- Email (opcional; exemplo Gmail com "App password") ----------
Email__Enabled=false
Email__SmtpHost=smtp.gmail.com
Email__SmtpPort=587
Email__UseStartTls=true
Email__Username=seu_email@gmail.com
Email__Password=seu_app_password
Email__From=seu_email@gmail.com
Email__To__0=seu_email@gmail.com

# ---------- Amazon.es (API oficial "Creators API") ----------
# Só funciona com uma conta Amazon Associates (Afiliados) aprovada e com acesso à Creators API
# (a Amazon exige 10 vendas qualificadas nos últimos 30 dias). Credenciais em:
# Associates Central → Tools → Creators API → Create Application / Add New Credential.
# A versão aparece ao lado da credencial; amazon.es = 3.2 (Europa). Sem isto, a loja Amazon mostra
# "integração não configurada" e não é contactada.
Amazon__CredentialId=sua_credential_id
Amazon__CredentialSecret=sua_credential_secret
Amazon__CredentialVersion=3.2
Amazon__PartnerTag=seu_partner_tag

# ---------- Proxy de saída (opcional, Squid "price-proxy") ----------
# false = ligação direta (por omissão). true = os pedidos às lojas/APIs de preços passam pelo price-proxy.
# O CallMeBot e o email NUNCA passam pelo proxy. O proxy não desbloqueia lojas que recusam o bot.
# Antes de ligar: põe o IP do tcgstockbot-webapi em proxy/allowed-clients.txt (ver README).
OutboundHttp__Proxy__Enabled=false
OutboundHttp__Proxy__Url=http://price-proxy:3128

# ---------- Limites por domínio (opcional; já têm valores por omissão no appsettings.json) ----------
