# Copia este ficheiro para ".env" (ao lado do docker-compose.yml) e preenche.
# O .env tem segredos: não o partilhes nem o metas no git.
# Sem espaços à volta do "=". Se um valor tiver # ou espaços, põe-no entre plicas: 'a#b c'.

# ---------- Obrigatório ----------

# Password do Card Forge (pedida no ecrã "Entrar"; "Manter sessão" guarda-a 30 dias em cada dispositivo).
DASHBOARD_PASSWORD=muda-isto

# Chave interna entre o dashboard e o bot. Inventa uma sequência longa e aleatória
# (ex.: no PowerShell:  -join ((48..57)+(97..122) | Get-Random -Count 40 | % {[char]$_}) ).
TCG_API_KEY=muda-isto-para-uma-chave-longa-e-aleatoria

# ---------- WhatsApp (CallMeBot) ----------
# 1. Guarda nos contactos o número do CallMeBot publicado em https://www.callmebot.com/blog/free-api-whatsapp-messages/
# 2. Envia-lhe pelo WhatsApp:  I allow callmebot to send me messages
# 3. Recebes a API key numa resposta. Põe o TEU número (com +351) e essa key abaixo.
WhatsApp__Enabled=false
WhatsApp__Phone=+351900000000
WhatsApp__ApiKey=

# ---------- Telegram (opcional) ----------
# 1. No Telegram, fala com @BotFather → /newbot → dá-lhe um nome. Recebes o token do bot (ex.: 123456:ABC-…).
# 2. Abre o teu bot novo e envia-lhe /start (sem isto o Telegram não deixa o bot escrever-te).
# 3. Descobre o teu chat id: fala com @userinfobot (responde com o teu "Id"). Para um grupo, o id começa por -100…
Telegram__Enabled=false
Telegram__BotToken=
Telegram__ChatId=

# ---------- Email (opcional; exemplo Gmail com "App password") ----------
Email__Enabled=false
Email__SmtpHost=smtp.gmail.com
Email__SmtpPort=587
Email__UseStartTls=true
Email__Username=
Email__Password=
Email__From=
Email__To__0=

# ---------- Amazon.es (API oficial "Creators API") ----------
# Só funciona com uma conta Amazon Associates (Afiliados) aprovada e com acesso à Creators API
# (a Amazon exige 10 vendas qualificadas nos últimos 30 dias). Credenciais em:
# Associates Central → Tools → Creators API → Create Application / Add New Credential.
# A versão aparece ao lado da credencial; amazon.es = 3.2 (Europa). Sem isto, a loja Amazon mostra
# "integração não configurada" e não é contactada.
Amazon__CredentialId=
Amazon__CredentialSecret=
Amazon__CredentialVersion=3.2
Amazon__PartnerTag=

# ---------- Limites por domínio (opcional; já têm valores por omissão no appsettings.json) ----------
# Valor = número MÍNIMO de SEGUNDOS entre dois pedidos ao mesmo domínio (subdomínios incluídos).
# OutboundHttp__RateLimits__amazon.es=2
# OutboundHttp__DefaultRateLimitSeconds=2

# ---------- FNAC / Worten / El Corte Inglés (feeds de afiliados Awin) ----------
# Nenhuma destas lojas tem API pública de produtos. A fonte autorizada é o feed de produtos do programa de
# afiliados na Awin (https://www.awin.com), depois de o programa te aprovar:
#   El Corte Inglés ES → programa 13075 · Worten PT → programa 99897 (confirma se tem feed) · FNAC PT → sem programa confirmado.
# Em Awin → Toolbox → Create-a-Feed: escolhe o feed, formato CSV, delimitador vírgula, compressão gzip e as colunas
# product_name, search_price, currency, in_stock, stock_status, merchant_deep_link, aw_deep_link, merchant_product_id, merchant_name.
# Cola aqui o URL de download (é secreto: contém a tua chave de feed). Vazio = loja não configurada.
AwinFeeds__Feeds__ElCorteIngles=
AwinFeeds__Feeds__Worten=
AwinFeeds__Feeds__Fnac=
# Outras lojas com a plataforma "Awin (genérico)": a chave é a que puseste na loja, ex.:
# AwinFeeds__Feeds__MediaMarktES=
