@model DashboardModel
@{
    ViewData["Title"] = Model.ApplicationName;
}

<div class="app" id="app" data-poll-ms="@Model.PollMilliseconds" data-version="@Model.Version">
    <aside class="sidebar" id="sidebar" aria-label="Menu">
        <a class="brand" href="#/radar">
            <span class="brand-mark" aria-hidden="true">
                <svg viewBox="0 0 24 24"><path d="M3 12a9 9 0 1 0 18 0a9 9 0 1 0-18 0M7.5 12a4.5 4.5 0 1 0 9 0a4.5 4.5 0 1 0-9 0M12 12l6.5-6.5" /></svg>
            </span>
            <span class="brand-text">
                <span class="brand-name">TcgStock Bot</span>
                <span class="brand-sub">monitor de stock · @Model.Version</span>
            </span>
        </a>

        <nav class="nav" id="nav" aria-label="Principal"></nav>

        <div class="bot-card" id="bot-card"></div>
    </aside>
    <div class="sidebar-backdrop" id="sidebar-backdrop"></div>

    <div class="main">
        <header class="mobile-bar">
            <button class="icon-btn" id="menu-button" type="button" aria-label="Abrir menu">
                <svg class="icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16" /></svg>
            </button>
            <span class="mobile-title" id="mobile-title">TcgStock Bot</span>
            <span class="status-chip" id="status-chip"></span>
        </header>

        <main class="view" id="view" tabindex="-1"></main>
    </div>

    <nav class="tabbar" id="tabbar" aria-label="Atalhos"></nav>
</div>

<div class="drawer-backdrop" id="drawer-backdrop"></div>
<aside class="drawer" id="drawer" aria-hidden="true" role="dialog" aria-modal="true"></aside>
<div class="modal-backdrop" id="modal"></div>
<div class="toasts" id="toasts" role="status" aria-live="polite"></div>

@section Scripts {
    <script src="~/js/core.js" asp-append-version="true"></script>
    <script src="~/js/shell.js" asp-append-version="true"></script>
    <script src="~/js/radar.js" asp-append-version="true"></script>
    <script src="~/js/watch.js" asp-append-version="true"></script>
    <script src="~/js/alerts.js" asp-append-version="true"></script>
    <script src="~/js/stores.js" asp-append-version="true"></script>
    <script src="~/js/compare.js" asp-append-version="true"></script>
    <script src="~/js/settings.js" asp-append-version="true"></script>
    <script src="~/js/editors.js" asp-append-version="true"></script>
    <script src="~/js/main.js" asp-append-version="true"></script>
}
