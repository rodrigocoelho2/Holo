@model LandingModel
@{
    ViewData["Title"] = "Card Forge";
    var cta = Model.SignedIn ? "/" : "/sign-in";
    var ctaLabel = Model.SignedIn ? "Open Card Forge" : "Sign in";
}
@section Head {
    <link rel="stylesheet" href="~/css/public.css" asp-append-version="true" />
}

<div class="landing">
    <header class="landing-bar">
        <a class="landing-brand" href="/about">
            <img src="~/img/card-forge.svg" width="36" height="36" alt="" />
            <span>Card Forge</span>
        </a>
        <a class="landing-cta small" href="@cta">@ctaLabel</a>
    </header>

    <main>
        <section class="lp-hero">
            <div class="lp-hero-text">
                <p class="eyebrow">Sealed TCG monitor · Portugal &amp; Spain</p>
                <h1>Catch sealed product <span class="ember">at the right price.</span></h1>
                <p class="lead">Card Forge watches Portuguese and Spanish stores for you — stock, prices and pre-orders — and pings your
                    phone the minute the product you want shows up at your price.</p>
                <div class="lp-hero-actions">
                    <a class="landing-cta" href="@cta">@ctaLabel</a>
                    <a class="landing-link" href="#how-it-works">How it works ↓</a>
                </div>
                <ul class="game-row" aria-label="Games">
                    <li class="g-pokemon">Pokémon</li>
                    <li class="g-onepiece">One Piece</li>
                    <li class="g-riftbound">Riftbound</li>
                    <li class="g-cyberpunk">Cyberpunk</li>
                    <li class="g-more">Lorcana, Magic…</li>
                </ul>
            </div>

            <figure class="phone" aria-label="Example alerts">
                <div class="phone-screen">
                    <div class="phone-top"><span>09:41</span><span class="phone-pill"></span><span>5G</span></div>
                    <div class="notif">
                        <div class="notif-head"><img src="~/img/card-forge.svg" width="20" height="20" alt="" /> Card Forge <span>now</span></div>
                        <strong>🟢 In stock at your price</strong>
                        <p>Elite Trainer Box · Example store</p>
                        <p class="notif-price">€54.90 <span class="good">−8% vs MSRP</span></p>
                    </div>
                    <div class="notif dim">
                        <div class="notif-head"><img src="~/img/card-forge.svg" width="20" height="20" alt="" /> Card Forge <span>2 h ago</span></div>
                        <strong>🔻 Price drop</strong>
                        <p>Booster Bundle · Another store</p>
                        <p class="notif-price">€27.50 <s>€32.90</s></p>
                    </div>
                    <div class="notif dim">
                        <div class="notif-head"><img src="~/img/card-forge.svg" width="20" height="20" alt="" /> Card Forge <span>yesterday</span></div>
                        <strong>🕒 Pre-orders open</strong>
                        <p>Booster Display · out on 14 Nov</p>
                    </div>
                </div>
                <figcaption>Example alerts (WhatsApp, Telegram or email).</figcaption>
            </figure>
        </section>

        <section class="features" aria-labelledby="features-h">
            <h2 id="features-h">Everything you need to never miss a release</h2>
            <div class="feature-grid">
                <article>
                    <span class="f-icon"><svg viewBox="0 0 24 24"><path d="M3 12a9 9 0 1 0 18 0a9 9 0 1 0-18 0M7.5 12a4.5 4.5 0 1 0 9 0a4.5 4.5 0 1 0-9 0M12 12l6.5-6.5" /></svg></span>
                    <h3>Offer radar</h3>
                    <p>What is in stock right now, at your price and in the right language. The last 24 hours come first.</p>
                </article>
                <article>
                    <span class="f-icon"><svg viewBox="0 0 24 24"><path d="M12 3v18M17 7.5c0-1.9-2.2-3-5-3s-5 1.1-5 3 2.2 2.9 5 3.4 5 1.6 5 3.6-2.2 3-5 3-5-1.1-5-3" /></svg></span>
                    <h3>Fair price (MSRP)</h3>
                    <p>Say “up to MSRP + 10%” and every product type — ETB, bundle, display — gets its own limit. No maths.</p>
                </article>
                <article>
                    <span class="f-icon"><svg viewBox="0 0 24 24"><path d="M4 19h16M5 15l4-5 4 3 6-7" /></svg></span>
                    <h3>Catalogue and history</h3>
                    <p>Every product across every store: the cheapest, who has stock, and a price chart from 7 days to 1 year.</p>
                </article>
                <article>
                    <span class="f-icon"><svg viewBox="0 0 24 24"><path d="M4 6h16v14H4zM4 10h16M8 3v5M16 3v5" /></svg></span>
                    <h3>Releases</h3>
                    <p>A calendar of upcoming sets, with when pre-orders open and how each one is doing.</p>
                </article>
                <article>
                    <span class="f-icon"><svg viewBox="0 0 24 24"><path d="M6 16v-5a6 6 0 1 1 12 0v5l2 2H4zM10 20.5a2 2 0 0 0 4 0" /></svg></span>
                    <h3>Alerts where you want them</h3>
                    <p>WhatsApp, Telegram or email: restocks, price drops and pre-orders. Plus a daily summary, if you like.</p>
                </article>
                <article>
                    <span class="f-icon"><svg viewBox="0 0 24 24"><path d="M12 3l8 3v6c0 4.5-3.4 8.3-8 9-4.6-.7-8-4.5-8-9V6zM9 12l2 2 4-4" /></svg></span>
                    <h3>Plays fair with stores</h3>
                    <p>Only uses what stores make available (public search, official APIs and feeds), with pauses between requests. Never gets around protections.</p>
                </article>
            </div>
        </section>

        <section class="how" id="how-it-works" aria-labelledby="steps-h">
            <h2 id="steps-h">How it works</h2>
            <ol>
                <li><span>1</span><div><h3>Pick the product</h3><p>Search for a set or a product. Card Forge looks for it in every store and shows you what it found.</p></div></li>
                <li><span>2</span><div><h3>Set the price</h3><p>MSRP + a margin, or a max price. Pick the language and the product types you care about.</p></div></li>
                <li><span>3</span><div><h3>Get the alert</h3><p>Every few minutes the bot checks the stores. When it shows up at your price, your phone buzzes.</p></div></li>
            </ol>
        </section>

        <section class="install" aria-labelledby="install-h">
            <img src="~/img/icon-192.png" width="64" height="64" alt="" />
            <div>
                <h2 id="install-h">Install it on your phone</h2>
                <p><strong>iPhone:</strong> in Safari, tap Share → <em>Add to Home Screen</em>.
                    <strong>Android:</strong> in Chrome, ⋮ → <em>Add to Home screen</em> or <em>Install app</em>.</p>
            </div>
            <a class="landing-cta" href="@cta">@ctaLabel</a>
        </section>
    </main>

    <footer class="landing-foot">
        <span><img src="~/img/card-forge.svg" width="18" height="18" alt="" /> Card Forge @Model.Version</span>
        <span>A private bot: your data stays on your own server.</span>
    </footer>
</div>
