@model TcgStockBot.Website.Model.Account.AccountPageModel
@{
    ViewData["Title"] = "Create account";
    ViewData["Tab"] = "create";
}
@section Head {
    <link rel="stylesheet" href="~/css/public.css" asp-append-version="true" />
}

<main class="login-page">
    <form class="login-card" method="post" action="/create-account" autocomplete="on">
        @Html.AntiForgeryToken()
        <input type="hidden" name="returnUrl" value="@Model.ReturnUrl" />
        <partial name="_AccountCard" model="Model" />

        <div class="login-heading">
            @if (Model.IsFirstAccount)
            {
                <h1>Set up Card Forge</h1>
                <p>Create the first account. It will be the admin, and can manage the other accounts.</p>
            }
            else
            {
                <h1>Create your account</h1>
                <p>Pick a user name and a password to sign in with.</p>
            }
        </div>

        @if (Model.NeedsSetupKey)
        {
            <label class="login-field">
                <span>Setup key</span>
                <span class="password-box">
                    <input id="setupKey" name="setupKey" type="password" autocomplete="off" required />
                    <button type="button" class="password-toggle" data-for="setupKey" aria-pressed="false" aria-label="Show setup key">
                        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M2 12s3.6-7 10-7 10 7 10 7-3.6 7-10 7S2 12 2 12zM9 12a3 3 0 1 0 6 0a3 3 0 1 0-6 0" /></svg>
                    </button>
                </span>
                <small class="login-hint">The <code>DASHBOARD_PASSWORD</code> from the <code>.env</code> file on the NAS. Only needed for this first account.</small>
            </label>
        }

        <label class="login-field">
            <span>User name</span>
            <input name="userName" type="text" value="@Model.UserName" autocomplete="username" autocapitalize="none" spellcheck="false"
                   minlength="3" maxlength="32" pattern="[A-Za-z0-9._\-]{3,32}" required autofocus />
            <small class="login-hint">3 to 32 letters, digits, dots, dashes or underscores.</small>
        </label>

        <label class="login-field">
            <span>Password</span>
            <span class="password-box">
                <input id="newPassword" name="password" type="password" autocomplete="new-password" minlength="@Model.MinPasswordLength" required />
                <button type="button" class="password-toggle" data-for="newPassword" aria-pressed="false" aria-label="Show password">
                    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M2 12s3.6-7 10-7 10 7 10 7-3.6 7-10 7S2 12 2 12zM9 12a3 3 0 1 0 6 0a3 3 0 1 0-6 0" /></svg>
                </button>
            </span>
            <small class="login-hint">At least @Model.MinPasswordLength characters.</small>
        </label>

        <label class="login-field">
            <span>Confirm password</span>
            <input name="confirmPassword" type="password" autocomplete="new-password" minlength="@Model.MinPasswordLength" required />
        </label>

        <label class="login-check">
            <input type="checkbox" name="remember" value="true" @(Model.Remember ? "checked" : "") />
            <span>Keep me signed in on this device <small>(@Model.RememberDays days)</small></span>
        </label>

        <button class="login-submit" type="submit">@(Model.IsFirstAccount ? "Create admin account" : "Create account")</button>

        @if (!Model.IsFirstAccount)
        {
            <p class="login-switch">Already have an account? <a href="/sign-in">Sign in</a></p>
        }
    </form>
</main>

<partial name="_PasswordToggle" />
