@model TcgStockBot.Website.Model.Account.AccountPageModel
@{
    ViewData["Title"] = Model.IsFirstAccount ? "Set up Holo" : "Create account";
    ViewData["Tab"] = "create";
    const string eye = "<svg viewBox=\"0 0 24 24\" aria-hidden=\"true\"><path d=\"M2.5 12S6 5.5 12 5.5 21.5 12 21.5 12 18 18.5 12 18.5 2.5 12 2.5 12Z\"/><circle cx=\"12\" cy=\"12\" r=\"3\"/></svg>";
    const string lockIcon = "<svg viewBox=\"0 0 24 24\" aria-hidden=\"true\"><rect x=\"4.5\" y=\"10.5\" width=\"15\" height=\"10\" rx=\"3\"/><path d=\"M8 10.5V8a4 4 0 0 1 8 0v2.5\"/></svg>";
}
@section Head {
    <link rel="stylesheet" href="~/css/public.css" asp-append-version="true" />
}

<div class="au">
    <div class="au-wrap">
        <partial name="_AccountSide" model="Model" />

        <main class="au-main">
            <form class="au-form" method="post" action="/create-account" autocomplete="on">
                @Html.AntiForgeryToken()
                <input type="hidden" name="returnUrl" value="@Model.ReturnUrl" />

                <div>
                    @if (Model.IsFirstAccount)
                    {
                        <h1>Set up Holo</h1>
                        <p class="lead2">Create the first account.</p>
                    }
                    else
                    {
                        <h1>Create your account</h1>
                        <p class="lead2">Pick a user name and a password to sign in with.</p>
                    }
                </div>

                <partial name="_AccountCard" model="Model" />

                @if (Model.IsFirstAccount)
                {
                    <div class="au-first">
                        <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="9" /><path d="M12 11v5M12 7.6v.1" /></svg>
                        <span>A new Holo: the first account becomes the admin and can manage the other accounts.</span>
                    </div>
                }

                @if (Model.NeedsSetupKey)
                {
                    <label class="au-field">
                        Setup key
                        <span class="au-in">
                            <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="8" cy="15" r="4" /><path d="m11 12 8-8M16 7l2 2M14 9l2 2" /></svg>
                            <input id="setupKey" name="setupKey" type="password" autocomplete="off" required />
                            <button type="button" class="password-toggle" data-for="setupKey" aria-pressed="false" aria-label="Show setup key">@Html.Raw(eye)</button>
                        </span>
                        <small>The <code>DASHBOARD_PASSWORD</code> from the <code>.env</code> file on the NAS. Only needed for this first account.</small>
                    </label>
                }

                <label class="au-field">
                    User name
                    <span class="au-in">
                        <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="8.5" r="4" /><path d="M4.5 20a7.5 7.5 0 0 1 15 0" /></svg>
                        <input name="userName" type="text" value="@Model.UserName" autocomplete="username" autocapitalize="none" spellcheck="false"
                               minlength="3" maxlength="32" pattern="[A-Za-z0-9._\-]{3,32}" required autofocus />
                    </span>
                    <small>3 to 32 letters, digits, dots, dashes or underscores.</small>
                </label>

                <label class="au-field">
                    Password
                    <span class="au-in">
                        @Html.Raw(lockIcon)
                        <input id="newPassword" name="password" type="password" autocomplete="new-password" minlength="@Model.MinPasswordLength" required />
                        <button type="button" class="password-toggle" data-for="newPassword" aria-pressed="false" aria-label="Show password">@Html.Raw(eye)</button>
                    </span>
                    <small>At least @Model.MinPasswordLength characters.</small>
                </label>

                <label class="au-field">
                    Confirm password
                    <span class="au-in">
                        @Html.Raw(lockIcon)
                        <input name="confirmPassword" type="password" autocomplete="new-password" minlength="@Model.MinPasswordLength" required />
                    </span>
                </label>

                <label class="au-check">
                    <input type="checkbox" name="remember" value="true" @(Model.Remember ? "checked" : "") />
                    <span>Keep me signed in on this device <small>(@Model.RememberDays days)</small></span>
                </label>

                <button class="btn-f foil" type="submit">@(Model.IsFirstAccount ? "Create admin account" : "Create account") <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6" /></svg></button>

                @if (!Model.IsFirstAccount)
                {
                    <p class="au-fine">Already have an account? <a href="/sign-in">Sign in</a></p>
                }
            </form>
        </main>
    </div>
</div>

<partial name="_PasswordToggle" />
<script src="~/js/theme-toggle.js" asp-append-version="true"></script>
