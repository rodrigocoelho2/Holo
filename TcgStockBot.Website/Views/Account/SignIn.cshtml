@model TcgStockBot.Website.Model.Account.AccountPageModel
@{
    ViewData["Title"] = "Sign in";
    ViewData["Tab"] = "sign-in";
}
@section Head {
    <link rel="stylesheet" href="~/css/public.css" asp-append-version="true" />
}

<div class="au">
    <div class="au-wrap">
        <partial name="_AccountSide" model="Model" />

        <main class="au-main">
            <form class="au-form" method="post" action="/sign-in" autocomplete="on">
                @Html.AntiForgeryToken()
                <input type="hidden" name="returnUrl" value="@Model.ReturnUrl" />

                <div>
                    <h1>Sign in</h1>
                    <p class="lead2">See what's in stock at your price.</p>
                </div>

                <partial name="_AccountCard" model="Model" />

                <label class="au-field">
                    User name
                    <span class="au-in">
                        <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="8.5" r="4" /><path d="M4.5 20a7.5 7.5 0 0 1 15 0" /></svg>
                        <input name="userName" type="text" value="@Model.UserName" autocomplete="username" autocapitalize="none" spellcheck="false" required autofocus />
                    </span>
                </label>

                <label class="au-field">
                    Password
                    <span class="au-in">
                        <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="4.5" y="10.5" width="15" height="10" rx="3" /><path d="M8 10.5V8a4 4 0 0 1 8 0v2.5" /></svg>
                        <input id="password" name="password" type="password" autocomplete="current-password" required />
                        <button type="button" class="password-toggle" data-for="password" aria-pressed="false" aria-label="Show password">
                            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M2.5 12S6 5.5 12 5.5 21.5 12 21.5 12 18 18.5 12 18.5 2.5 12 2.5 12Z" /><circle cx="12" cy="12" r="3" /></svg>
                        </button>
                    </span>
                </label>

                <label class="au-check">
                    <input type="checkbox" name="remember" value="true" @(Model.Remember ? "checked" : "") />
                    <span>Keep me signed in on this device <small>(@Model.RememberDays days)</small></span>
                </label>

                <button class="btn-f foil" type="submit">Sign in <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6" /></svg></button>

                @if (Model.CanCreateAccount)
                {
                    <p class="au-fine">No account yet? <a href="/create-account">Create one</a></p>
                }
                else
                {
                    <p class="au-fine">No account yet? Ask whoever runs this Holo to create one for you.</p>
                }
            </form>
        </main>
    </div>
</div>

<partial name="_PasswordToggle" />
