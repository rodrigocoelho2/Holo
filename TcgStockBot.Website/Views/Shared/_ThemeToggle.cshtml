@* The light/dark switch on the public pages: one round button, sun in dark mode and moon in light (js/theme-toggle.js). *@
<button type="button" class="theme-toggle" data-theme-toggle aria-label="Switch to light mode" title="Light / dark">
    <svg class="tt-sun" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="4.2" /><path d="M12 2.5v2.2M12 19.3v2.2M4.6 4.6l1.6 1.6M17.8 17.8l1.6 1.6M2.5 12h2.2M19.3 12h2.2M4.6 19.4l1.6-1.6M17.8 6.2l1.6-1.6" /></svg>
    <svg class="tt-moon" viewBox="0 0 24 24" aria-hidden="true"><path d="M20 14.6A8.3 8.3 0 1 1 9.4 4a6.6 6.6 0 0 0 10.6 10.6Z" /></svg>
</button>
