@inject Microsoft.AspNetCore.Antiforgery.IAntiforgery Antiforgery
@{
    var antiforgeryToken = Antiforgery.GetAndStoreTokens(Context).RequestToken;
}
<!doctype html>
<html lang="pt-PT" data-mode="dark" data-accent="azul">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="request-verification-token" content="@antiforgeryToken" />
    <meta name="color-scheme" content="dark light" />
    <title>@ViewData["Title"]</title>
    <link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'%3E%3Crect width='32' height='32' rx='9' fill='%238C96F0'/%3E%3Cg fill='none' stroke='%23111318' stroke-width='2.6' stroke-linecap='round'%3E%3Ccircle cx='16' cy='16' r='9'/%3E%3Ccircle cx='16' cy='16' r='4'/%3E%3Cpath d='M16 16l6.5-6.5'/%3E%3C/g%3E%3C/svg%3E" />
    <script>
        /* Theme before first paint (per browser, never data): accent + dark/light/auto. Dark is the default. */
        (function () {
            var read = function (name, fallback) {
                try { var value = localStorage.getItem("tcgstockbot." + name); return value === null ? fallback : JSON.parse(value); } catch (e) { return fallback; }
            };
            var accent = read("accent", "azul");
            var mode = read("mode", "dark");
            if (mode === "auto") mode = window.matchMedia && window.matchMedia("(prefers-color-scheme: light)").matches ? "light" : "dark";
            document.documentElement.setAttribute("data-accent", accent);
            document.documentElement.setAttribute("data-mode", mode === "light" ? "light" : "dark");
        })();
    </script>
    <link rel="preload" href="~/fonts/geist-latin-400-normal.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="~/fonts/bricolage-grotesque-latin-700-normal.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="stylesheet" href="~/css/dashboard.css" asp-append-version="true" />
</head>
<body>
    @RenderBody()
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
