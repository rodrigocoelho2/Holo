@HostAddress = http://127.0.0.1:5081
@apiKey = devkey

### Status
GET {{HostAddress}}/user/status
x-api-key: {{apiKey}}

### List
GET {{HostAddress}}/user/list
x-api-key: {{apiKey}}

### Create (the first account is an admin)
POST {{HostAddress}}/user
Content-Type: application/json
x-api-key: {{apiKey}}

{ "userName": "rodas", "password": "a-long-password" }

### Sign in
POST {{HostAddress}}/user/signin
Content-Type: application/json
x-api-key: {{apiKey}}

{ "userName": "rodas", "password": "a-long-password" }
