{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "System.Net.Http.HttpClient": "Warning"
    }
  },
  "AllowedHosts": "*",
  "TcgStockBot": {
    "DataDirectory": "data",
    "ApiKey": "",
    "StoreRequestTimeout": "00:00:30"
  },
  "Email": {
    "Enabled": false,
    "SmtpHost": "smtp.gmail.com",
    "SmtpPort": 587,
    "UseStartTls": true,
    "Username": "",
    "From": "",
    "To": []
  },
  "WhatsApp": {
    "Enabled": false,
    "Phone": "",
    "MaxAlertsPerMessage": 5
  },
  "OutboundHttp": {
    "ConnectTimeout": "00:00:10",
    "DefaultRateLimitSeconds": 2,
    "RateLimits": {
      "amazon.es": 2,
      "fnac.pt": 10,
      "worten.pt": 10,
      "elcorteingles.es": 10
    },
    "MaxThrottleWait": "00:00:30",
    "MaxBackoff": "01:00:00"
  },
  "Amazon": {
    "CredentialId": "",
    "CredentialSecret": "",
    "CredentialVersion": "3.2",
    "PartnerTag": "",
    "Marketplace": "www.amazon.es",
    "ApiBaseUrl": "https://creatorsapi.amazon"
  },
  "AwinFeeds": {
    "Feeds": {
      "Fnac": "",
      "Worten": "",
      "ElCorteIngles": ""
    },
    "RefreshInterval": "06:00:00",
    "RetryAfterFailure": "00:30:00",
    "KeepKeywords": [ "pokemon", "one piece", "lorcana", "gathering" ],
    "MaxProducts": 5000
  },
  "Bot": {
    "Paused": false,
    "PollInterval": "00:10:00",
    "PollJitter": "00:02:00",
    "DelayBetweenRequests": "00:00:03",
    "UserAgent": "TcgStockBot/1.0 (personal stock alert)",
    "Wishlist": [
      {
        "Id": "etb",
        "Name": "Elite Trainer Box (EN)",
        "SearchQuery": "elite trainer box",
        "RequiredKeywords": [ "elite trainer box" ],
        "ExcludedKeywords": [ "sleeves", "binder", "portfolio", "case", "proxy", "vazia", "empty", "break", "acrylic", "acrilico" ],
        "MaxPrice": 80.00
      },
      {
        "Id": "booster-bundle",
        "Name": "Booster Bundle (EN)",
        "SearchQuery": "booster bundle",
        "RequiredKeywords": [ "booster bundle" ],
        "ExcludedKeywords": [ "sleeves", "binder", "proxy", "break", "acrylic", "acrilico" ],
        "MaxPrice": 35.00
      }
    ],
    "Stores": [
      { "Name": "Trap Card TCG", "Platform": "Shopify", "BaseUrl": "https://trapcardtcg.com", "UnmarkedLanguage": "English" },
      { "Name": "Versus Gamecenter", "Platform": "Shopify", "BaseUrl": "https://versusgamecenter.pt", "UnmarkedLanguage": "English" },
      {
        "Name": "Panda Collecting",
        "Platform": "WooCommerce",
        "BaseUrl": "https://pandacollecting.com",
        "WooCommerceProductsPath": "/wp-json/wc/store/products",
        "UnmarkedLanguage": "English"
      },
      { "Name": "Note!", "Platform": "Shopify", "BaseUrl": "https://noteonline.pt", "UnmarkedLanguage": "Unknown" },
      {
        "Name": "CentroXogo",
        "Platform": "Html",
        "BaseUrl": "https://www.centroxogo.pt",
        "UnmarkedLanguage": "Confirm",
        "Html": {
          "SearchUrlTemplate": "https://www.centroxogo.pt/brinquedos-personagem/pokemon/cartas-pokemon.html?product_list_limit=36",
          "ProductSelector": "li.product-item",
          "TitleSelector": ".product-item-link",
          "PriceSelector": ".price",
          "LinkSelector": ".product-item-link",
          "OutOfStockSelector": ".stock.unavailable",
          "InStockSelector": ".tocart"
        }
      },
      {
        "Name": "Arena Porto",
        "Enabled": false,
        "Platform": "Html",
        "BaseUrl": "https://arenaporto.pt",
        "UnmarkedLanguage": "Unknown",
        "Html": {
          "SearchUrlTemplate": "https://arenaporto.pt/pesquisa?controller=search&s={query}",
          "ProductSelector": "article.product-miniature",
          "TitleSelector": ".product-title a",
          "PriceSelector": ".price",
          "LinkSelector": ".product-title a"
        }
      }
    ]
  }
}
